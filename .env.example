# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional external backend URL (leave empty to use the built-in /api backend)
VITE_API_BASE_URL=""

# Optional endpoint for external webhook forwarding
VITE_ENQUIRY_WEBHOOK_URL=""

# Server Port
PORT=3000

# Admin Account Bootstrap (hashed with scrypt in database)
ADMIN_USERNAME="qubexadmin"
ADMIN_EMAIL="admin@qubextech.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Session & CSRF Signing Secret (at least 32 random chars in production)
SESSION_SECRET="CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET"

# MySQL Configuration (when omitted, persistent local SQLite database is used automatically)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="qubex_user"
MYSQL_PASSWORD=""
MYSQL_DATABASE="qubex_enquiries"

# SMTP Email Notifications (Admin alerts when customer submits enquiry)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="qubex.tech.solutions@gmail.com"
SMTP_PASS="YOUR_SMTP_APP_PASSWORD"
SMTP_FROM="qubex.tech.solutions@gmail.com"
ADMIN_NOTIFICATION_EMAIL="qubex.tech.solutions@gmail.com"
